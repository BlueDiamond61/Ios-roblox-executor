<Window x:Class="MobileBloxStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobileBlox Studio" Height="780" Width="1240"
        MinHeight="620" MinWidth="900"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="9" Width="38" Height="38">
                        <TextBlock Text="Δ" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MOBILEBLOX STUDIO" FontSize="16" FontWeight="Bold" LetterSpacing="1"/>
                        <TextBlock Text="WINDOWS WORKSPACE" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="LOCAL EDITOR  •  NO ROBLOX PROCESS CONNECTION"
                           Foreground="#B69BFF" FontSize="10" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="New" Click="New_Click"/>
                <Button Content="Open" Click="Open_Click"/>
                <Button Content="Save" Click="Save_Click" Background="{StaticResource AccentBrush}"/>
                <Button Content="Save As" Click="SaveAs_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear" Click="Clear_Click"/>
                <Button Content="Preview Status" Click="Preview_Click" Background="#3B315B"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="SCRIPT LIBRARY" FontWeight="Bold" FontSize="11" Margin="4,4,4,12"/>
                        <Button Content="Refresh Library" Click="RefreshLibrary_Click" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <ListBox x:Name="ScriptList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" SelectionChanged="ScriptList_SelectionChanged"
                             Margin="0,8,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="9"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="#222234"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,12">
                        <TextBlock Text="EDITOR" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox x:Name="FileNameBox" Width="210" Height="30" Text="Untitled.lua"
                                 HorizontalAlignment="Right" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code"
                             FontSize="14" BorderThickness="0" Padding="14"
                             Text="-- Welcome to MobileBlox Studio&#x0a;-- Edit and organize your own Lua/Luau files here.&#x0a;&#x0a;local message = &quot;Hello, Studio!&quot;&#x0a;print(message)"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#14141E" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="OUTPUT CONSOLE" FontWeight="Bold"
                           FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8"/>
                <TextBox x:Name="ConsoleBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="Transparent" FontFamily="Cascadia Code" FontSize="12"
                         Text="MobileBlox Studio ready. Local editor initialized."/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="4,10,4,0">
            <TextBlock Text="Lua / Luau file workspace" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
            <TextBlock DockPanel.Dock="Right" Text="Windows • .NET 8 • WPF"
                       Foreground="{StaticResource MutedBrush}" FontSize="10"/>
        </DockPanel>
    </Grid>
</Window>
